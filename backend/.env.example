# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# ---- Supabase PostgreSQL (application data lives in the "app" schema) ----
# Supabase dashboard > Project Settings > Database > Connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Optional: force SSL on/off. Default: on, except for localhost.
DATABASE_SSL=

# ---- Auth ----
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- RAG boundary ----
# mock = MockRagService (development) | real = PythonRagService
RAG_MODE=mock
# Production variable. RAG_SERVICE_URL is retained for local compatibility.
PYTHON_RAG_URL=http://localhost:8000
RAG_SERVICE_URL=http://localhost:8000
RAG_SERVICE_TOKEN=
RAG_TIMEOUT_MS=120000
RAG_INGEST_TIMEOUT_MS=600000
# Mock only: return one clearly-labelled sample source so the UI source cards can be tested
MOCK_RAG_SOURCES=true

# Public Gemini protection. Defaults are suitable starting points for a prototype.
CHAT_RATE_LIMIT_WINDOW_MS=900000
CHAT_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=20

# ---- Uploads ----
# For Render, mount a persistent disk at /var/data and use /var/data/uploads.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
