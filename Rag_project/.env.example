# ──────────────────────────────────────────────
#  RAG Project – Environment Variables Template
# ──────────────────────────────────────────────

# ── Supabase PostgreSQL Database ──────────────
# Copy the URI connection string from Supabase Project Settings -> Database
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ── Google Gemini API ─────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Embedding Model (768 dimensions) ──────────
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# ── LLM Generation Model ──────────────────────
LLM_MODEL=gemini-3.8-flash

# ── Retrieval Settings ────────────────────────
TOP_K=5
HYBRID_RAG_STRONG_THRESHOLD=0.70
HYBRID_RAG_WEAK_THRESHOLD=0.52
HYBRID_MIN_RELEVANT_CHUNKS=1
HYBRID_MIN_CONTEXT_COVERAGE=0.20

# ── Private Node-to-RAG service authentication ──
NODE_ENV=development
RAG_REQUIRE_SERVICE_AUTH=false
RAG_SERVICE_TOKEN=

# ── Chunking Settings ─────────────────────────
CHUNK_SIZE=600
CHUNK_OVERLAP=75
